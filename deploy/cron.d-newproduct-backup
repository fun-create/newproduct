# NEW PRODUCT — 日次バックアップ（cron の定義の正本）。
#
#   sudo install -m 644 -o root -g root /opt/newproduct/deploy/cron.d-newproduct-backup /etc/cron.d/newproduct-backup
#   sudo chmod 755 /opt/newproduct/deploy/backup.sh   # 落ちていると毎晩静かに失敗する
#
# **実行者は newproduct（root ではない）。**2026-10-14 十文字さん判断（seisan と同じ形）。
# root が newproduct 持ちの台本を動かすと、アプリが乗っ取られたとき root まで広がる。
# 置き場 /var/backups/newproduct・中の控え・ログ /var/log/newproduct-backup.log は newproduct 持ち。
#
# 04:15。lpscope 3:15 / calfc 3:30 / autogrowth・seisan 3:45 / keiei 4:00 の次。
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
15 4 * * * newproduct /opt/newproduct/deploy/backup.sh >> /var/log/newproduct-backup.log 2>&1
