# NEW PRODUCT — /etc/caddy/Caddyfile へ足す断片。
#
# 2026-09-22 に /etc/caddy/Caddyfile へ反映済み。**正本は /etc のほう。**
# 直したら両方を揃えること（更新コマンドがズレを検知して知らせる）。
#
# 追記の手順:
#   sudo cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak-$(date +%Y%m%d-%H%M%S)
#   sudo sh -c 'cat /opt/newproduct/deploy/Caddyfile.fragment >> /etc/caddy/Caddyfile'
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# 前提: newproduct.fun-create.co.jp の A レコードが 162.43.43.186
#       （GMO 共用サーバーSD コントロールパネル）。**人の作業。**
# 既存ブロックは触らない。

newproduct.fun-create.co.jp {
    # **/api/svc/* だけを落とす。`/api/*` にしないこと。**
    # このアプリは画面が SPA で、ダッシュボード・案件・タスク・アイデア・プランは
    # すべて /api/... を叩く。2026-09-22 まで `path /api/*` になっており
    # （keiei の断片を写した際の取り違え。**あちらは画面がサーバー側生成**なので
    # /api はサーバ間専用で正しい）、**ログイン後の画面が全部
    # 「表示できませんでした」になっていた。**
    # ループバックでは 200 が返るので selfcheck にも e2e にも出ない。
    # 画面を足したら、**本番のURLで1回は叩いて確かめること。**
    #
    # /api/health は件数（アイデア881件・利用者数・ポート）を返すので外へ出さない。
    # 死活監視は /healthz（"ok" の1語）を使う。
    @svc path /api/svc/* /api/health
    respond @svc 404                      # サーバ間APIは外から落とす。
                                          # **アプリ側の3点判定と二重で塞ぐ**

    reverse_proxy 127.0.0.1:8794 {
        header_up X-Forwarded-Proto {scheme}   # 無いと Cookie に Secure が付かない
        header_up X-Real-IP {remote_host}      # この2つの「不在」が3点判定の2番目
    }
    request_body {
        max_size 10MB
    }
    encode gzip
    header {
        X-Content-Type-Options nosniff
        -Server
    }
}
