# 秘密情報（絶対に入れない）
config/users.json
config/users.json.*
config/.sessions.json
config/csrf_salt
config/svc_token
# ChatWork のAPIトークン（0600・十文字さんが置く）。**絶対に入れない**
config/chatwork.env
config/*.env

# 実データ。案件・タスク・ゲート・監査ログ。**作り直せない**ので
# git ではなく deploy/backup.sh（日次・30世代・04:15）で守る
data/
logs/

# キャッシュ
__pycache__/
*.pyc
.venv/

# 手作業のバックアップ
_backup_*/
*.bak_*
*.bak-*
*.before_*
*.orig
*.tmp

# macOS から scp したときに付いてくるゴミ
._*
.DS_Store

# useradd が置いていく雛形
.bashrc
.bash_logout
.profile

# deploy key（GitHub 接続用）。**絶対に入れない**
# 2026-09-21、鍵を作った直後は .gitignore が追いついておらず、
# 次の `git add .` で秘密鍵ごと commit に入る状態だった（push 前に発見）
.ssh/

# Claude Code の端末側の設定。**アプリの一部ではない。**
# 2026-09-20、keiei で本番作業したときに 982行（userID・machineID・機能フラグの
# キャッシュ）が commit に紛れ込み、GitHub へ出るところだった
.claude.json
